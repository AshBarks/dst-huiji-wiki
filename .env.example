# 灰机维基账号配置
HUIJI__USERNAME=your-username
HUIJI__PASSWORD=your-password
HUIJI__X_AUTHKEY=site-authkey

# DST 根目录
DST__ROOT="/home/user/.steam/debian-installation/steamapps/common/Don't Starve Together"

# ktools 图片管线（images-sync）
# 产物根目录：current/ 工作集 + history/ 差异历史（缺省 ./output/ktools）
KTOOLS__OUT_DIR=output/ktools

# 可选：物品图标 wiki 文件名例外映射表（本地文件名 → 站内文件名，含 .png；
# WebUI 物品图标弹窗可直接编辑；缺省 config/icon_title_overrides.json）
ICON__TITLE_OVERRIDES=config/icon_title_overrides.json

# 动画历史管线（anim-sync）
# 产物根目录：history/ 差异历史（缺省 ./output/anim）
ANIM__OUT_DIR=output/anim
# （已内置 KTEX 解码器 ktex-rs，无需外部 ktech 二进制）

# 可选：维基 API 节流与重试（默认 1 QPS、3 次退避重试）
WIKI__QPS=1
WIKI__MAX_RETRIES=3

# 可选：LLM API（未配置时 symbol-annotate --llm 会跳过 LLM 标注）
LLM__API_KEY=
LLM__BASE_URL=https://api.openai.com/v1
LLM__MODEL=gpt-4o-mini
# 可选：单次请求总超时秒数（大 Prompt + 推理模型可调大，默认 120）
LLM__TIMEOUT_SECS=300

    {
      "state": "attack",
      "note": "成年高脚鸟的攻击状态，播放攻击前摇和攻击动画，在动画12帧时造成伤害，攻击后短暂移除busy标签，允许其他行动。"
    },
    {
      "state": "peck",
      "note": "幼年高脚鸟特有攻击，啄击目标，在动画13帧时造成伤害，并可能触发目标显示“被啄”的对话。"
    },
    {
      "state": "hit",
      "note": "受击状态，高脚鸟受伤时播放受击动画，有短暂硬直，之后恢复到idle状态。"
    },
    {
      "state": "lay",
      "note": "产卵状态，高脚鸟播放产卵动画，在65帧时执行产卵动作，之后返回idle。"
    },
    {
      "state": "makenest",
      "note": "筑巢状态，高脚鸟尝试筑巢，如果成功则进入睡眠，否则返回idle。"
    },
    {
      "state": "growup",
      "note": "成长状态，幼年高脚鸟成长为成年形态，播放成长动画，完成后调用SpawnAdult函数生成成年高脚鸟。"
    },
    {
      "state": "gohome",
      "note": "回家状态，高脚鸟移动到巢穴并进入睡眠状态。"
    },
    {
      "state": "eat",
      "note": "进食状态，高脚鸟播放偷取动画，在11帧时执行进食动作，可能消耗或获取食物。"
    }

  "state_notes": [
    {
      "state": "idle",
      "note": "蝙蝠的待机状态，持续播放 `fly_loop` 飞行动画并伴有振翅音效。这是大多数状态的终点和起点。"
    },
    {
      "state": "flyaway",
      "note": "蝙蝠的飞离状态，触发条件如回家到陷坑。进入后无敌、隐藏阴影，并以约 10 的垂直速度向上飞行，最终消失。"
    },
    {
      "state": "flyback",
      "note": "蝙蝠的飞回状态，由 `fly_back` 事件触发 (如陷坑召唤)。进入后无敌，从高空 (y=15) 以约 10 的速度垂直降落，落地后恢复状态。"
    },
    {
      "state": "chew_ground",
      "note": "蝙蝠啃食硝石的特殊进食状态。播放较长的咀嚼动画序列 (`chew_pre`、多次 `chew_loop`、`chew_pst`)，期间会掉落并咀嚼食物。"
    },
    {
      "state": "eat_enter",
      "note": "蝙蝠拾取并开始进食食物的初始状态。播放 `eat` 动画，并在特定帧执行拾取动作 (带音效)。"
    },
    {
      "state": "eat_loop",
      "note": "蝙蝠的咀嚼循环状态。持续播放 `eat_loop` 动画，持续约 1-3 秒后执行进食动作。若在此状态被打，会掉落食物。"
    },
    {
      "state": "taunt",
      "note": "蝙蝠的挑衅状态，播放 `taunt` 动画和声音。可能是吸引玩家或其它生物的行为表现。"
    },
    {
      "state": "attack",
      "note": "蝙蝠的攻击状态，由 `CommonStates.AddCombatStates` 生成。在攻击动画第 11 帧执行一次伤害判定 (DoAttack)，并伴有啃咬音效。"
    }

  "category": "component",
  "display_name": "regrowthmanager",
  "summary": "该组件管理游戏内可再生实体（如胡萝卜、花、兔子洞等）的重生逻辑。它根据时间、季节、天气和玩家距离等条件自动刷新资源，并支持通过模组自定义再生类型。核心玩法涉及资源管理、环境交互和生存策略。",
  "api": [
    {
      "name": "SetRegrowthForType",
      "signature": "SetRegrowthForType(prefab, regrowtime, product, timemult)",
      "effect": "为指定预制体设置再生类型，包括再生时间、生成产品和时间乘数。更新内部字典 _regrowthvalues 和 _internaltimes，用于控制再生计时。"
    },
    {
      "name": "LongUpdate",
      "signature": "LongUpdate(dt)",
      "effect": "根据传入时间推进所有再生计时器，尝试在满足条件（如玩家距离、地形适宜性）时重生产品。失败时重置计时器并重新排队。"
    },
    {
      "name": "OnSave",
      "signature": "OnSave()",
      "effect": "保存当前所有再生计时器的状态，包括产品、剩余时间和位置，用于游戏存档。"
    },
    {
      "name": "OnLoad",
      "signature": "OnLoad(data)",
      "effect": "从保存数据中恢复再生计时器状态，重建内部计时列表。"
    },
    {
      "name": "GetDebugString",
      "signature": "GetDebugString()",
      "effect": "返回当前再生队列的调试信息，包括计时器数量、时间乘数和下一个重生时间。"
    }
  ],

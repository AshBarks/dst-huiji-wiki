  "state_notes": [
    {
      "state": "idle",
      "note": "基础待机状态，可被移动或攻击指令中断。表现为播放idle_loop动画，期间会发出待机音效。"
    },
    {
      "state": "taunt",
      "note": "嘲讽状态，表现为面向目标并播放特定动画和音效。期间有短暂硬直，之后恢复可行动。"
    },
    {
      "state": "hit",
      "note": "受击硬直状态。播放受击动画，并更新受击恢复延迟。若上次处于眩晕状态，则会直接进入stun_hit。状态中途可中断进行攻击或冲锋。"
    },
    {
      "state": "attack",
      "note": "普通攻击状态。播放攻击动画，在动画第14帧执行伤害判定，第28帧后取消‘忙碌’标签，可衔接其他状态。"
    },
    {
      "state": "joust_pre",
      "note": "冲锋准备状态。骑士会锁定目标、调整朝向并开始加速，为冲锋蓄力。期间会持续追踪目标方向（但转向角度有限）。"
    },
    {
      "state": "joust_loop",
      "note": "冲锋循环状态。骑士处于高速移动状态，期间持续对路径上的敌人造成伤害并击退。碰撞到其他‘jousting’单位会触发碰撞状态。最多循环3次。"
    },
    {
      "state": "joust_pst",
      "note": "冲锋结束状态。冲锋动能逐渐衰减直至停止，骑士恢复正常朝向。此状态后有短暂硬直。"
    },
    {
      "state": "joust_collide",
      "note": "冲锋碰撞状态。通常由两个冲锋中的骑士相撞触发，表现为被弹开并伴有硬直动画。此状态无法被睡眠中断。"
    },
    {
      "state": "stun_loop",
      "note": "眩晕循环状态，表现为倒地不起。在此状态期间，骑士受到攻击(stun_hit)会累计眩晕打击次数(stunhits)。若累计达到4次，将提前退出眩晕。"
    },
    {
      "state": "stun_hit",
      "note": "眩晕中的受击状态，是延长眩晕时间的主要手段。每次进入都会增加‘stunhits’计数，当计数≥4时，会直接转入眩晕恢复(stun_pst)。"
    }
  ],

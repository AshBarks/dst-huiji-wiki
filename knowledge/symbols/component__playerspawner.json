  "category": "component",
  "display_name": "playerspawner",
  "summary": "该组件管理玩家生成点，支持固定和分散两种生成模式。处理玩家的生成、消失和跨世界迁移逻辑，包括坐标传送和宠物跟随。包含基于环境条件的生成保护机制，为玩家提供临时无敌状态。",
  "api": [
    {
      "name": "SpawnAtNextLocation",
      "effect": "获取下一个生成位置坐标，并调用SpawnAtLocation生成玩家。"
    },
    {
      "name": "SpawnAtLocation",
      "effect": "将玩家传送到指定坐标，处理迁移宠物的重定位，记录玩家生成历史，在黑暗中生成光源，根据条件添加生成保护增益，并执行生成动画以启用玩家控制。"
    },
    {
      "name": "GetAnySpawnPoint",
      "effect": "返回下一个生成位置的坐标(x, y, z)，若无可用点则返回(0, 0, 0)。"
    },
    {
      "name": "IsPlayersInitialSpawn",
      "effect": "检查玩家是否是首次在世界中生成，返回布尔值。"
    },
    {
      "name": "OnSave",
      "effect": "保存组件状态，包括已生成的玩家列表。"
    },
    {
      "name": "OnLoad",
      "effect": "加载组件状态，恢复已生成的玩家列表。"
    },
    {
      "name": "OnRemoveEntity",
      "effect": "清理实体，移除所有注册的迁移门户。"
    }
  ],

  "state_notes": [
    {
      "state": "emerge",
      "note": "蜂后出现时进入，拥有短暂无敌帧（约54帧），播放出现动画并触发尖叫警报，震慑周围玩家，之后开始扇动翅膀飞行。"
    },
    {
      "state": "screech",
      "note": "尖叫状态，蜂后停止移动发出尖叫，触发屏幕震动和恐惧效果（范围5），警报所有护卫蜂，是重要的控制技能窗口。"
    },
    {
      "state": "attack",
      "note": "攻击状态，蜂后对目标发动一次攻击，造成伤害，攻击前有准备动画，攻击后有短暂硬直，可被中断。"
    },
    {
      "state": "spawnguards",
      "note": "召唤护卫状态，蜂后停止移动生成若干护卫蜂（数量2-3只，最多10只），之后护卫围绕蜂后形成防线，冷却时间可配置。"
    },
    {
      "state": "focustarget",
      "note": "焦点目标状态，蜂后指挥护卫攻击特定玩家或实体，增加精神光环（-TUNING.SANITYAURA_HUGE），持续约3次循环，是强化攻击模式。"
    },
    {
      "state": "death",
      "note": "死亡状态，蜂后播放死亡动画，期间尖叫警报，之后掉落战利品并消失，标记蜂巢已被击败。"
    },
    {
      "state": "hit",
      "note": "被击中状态，蜂后停止移动播放受击动画，有硬直时间（约10帧），可中断并快速恢复攻击，但受最大硬直锁限制。"
    },
    {
      "state": "flyaway",
      "note": "飞走状态，蜂后起飞逃离，进入无敌状态，清除焦点目标并命令护卫逃跑，最终移除实体，用于脱战或特殊事件。"
    },
    {
      "state": "idle",
      "note": "空闲状态，蜂后检查是否有待执行动作（如尖叫、飞走），否则播放呼吸动画，是状态转换的中心节点。"
    }
  ],

  "state_notes": [
    {
      "state": "submerge",
      "note": "空闲超时且附近无牛时钻入地下，关闭物理与阴影并设为不可攻击状态，随后转为种植态。"
    },
    {
      "state": "emerge_fast",
      "note": "快速钻出地面，播放钻出动画并启用阴影，记录钻出时间用于后续潜伏计时。"
    },
    {
      "state": "eat",
      "note": "响应进食动作，动画第25帧执行缓冲动作完成进食，结束后可能潜地或返回空闲。"
    },
    {
      "state": "stunned",
      "note": "被击晕炸弹等触发，持续6±2秒硬直，期间允许被玩家捡起（canbepickedup=true）。"
    },
    {
      "state": "trapped",
      "note": "触发陷阱事件后被困1秒，标签禁止触电，之后自动返回空闲状态。"
    },
    {
      "state": "exhausted",
      "note": "赛跑中收到力竭事件进入，循环播放喘息动画直至组件判断不再力竭，可能转睡眠。"
    },
    {
      "state": "alert",
      "note": "赛跑空闲时根据最佳属性随机播放速度/方向/反应/耐力展示动画，用于赛前炫耀。"
    },
    {
      "state": "race_start_stunned",
      "note": "赛跑起步被惊吓击晕，根据传入循环次数重复硬直动画后恢复。"
    },
    {
      "state": "fall",
      "note": "从高处坠落做抛物线运动，落地后转为被击晕状态。"
    },
    {
      "state": "gohome",
      "note": "响应回家动作，若目标无HasCarrat标签则执行缓冲动作否则取消并空闲。"

  "state_notes": [
    {
      "state": "yawn",
      "note": "熊獾打哈欠使周围玩家与睡眠者陷入睡眠，帧50触发范围睡眠效果，并启动Yawn冷却计时器。"
    },
    {
      "state": "attack",
      "note": "普通弧形攻击，帧32-33进行AOE伤害判定并破坏场景物品，未命中目标时推送onmissother事件。"
    },
    {
      "state": "pound",
      "note": "地面重击状态，帧20触发GroundPound造成范围震动与伤害，冷却由BEARGER_NORMAL_GROUNDPOUND_COOLDOWN控制。"
    },
    {
      "state": "butt",
      "note": "屁股向后撞击，造成范围伤害与击退并生成bearger_sinkhole，期间关闭角色碰撞且不可中断。"
    },
    {
      "state": "hit",
      "note": "四足姿态受击硬直，结束后可转入反击或踉跄，具有受击恢复延迟与可中断窗口。"
    },
    {
      "state": "sleep",
      "note": "进入睡眠前置，清除进食计时与踉跄标记，根据当前姿态播放睡眠动画并可能持续睡眠。"
    },
    {
      "state": "run",
      "note": "奔跑状态，高速移动并破坏沿途物品，同时循环播放咆哮音效与脚步震动。"
    },
    {
      "state": "eat_loop",
      "note": "进食循环状态，执行缓冲的进食动作并随机超时，咀嚼音效与蜂蜜标签影响时长。"
    },
    {
      "state": "death",

    {
      "state": "emerge_fast",
      "note": "快速出土状态，播放 emerge_fast 动画并记忆出土时间，用于后续判断是否需要再次钻地。"
    },
    {
      "state": "eat",
      "note": "进食动作状态，第25帧执行缓冲的进食动作，结束后若附近无牛则钻地。"
    },
    {
      "state": "stunned",
      "note": "被眩晕硬直，物品组件设为可拾取，随机持续约4-8秒(6±2)后播放解除动画。"
    },
    {
      "state": "trapped",
      "note": "被陷阱捕获，清除动作并播放眩晕循环1秒后返回空闲。"
    },
    {
      "state": "exhausted",
      "note": "赛跑力竭初始状态，播放力竭前摇，之后循环 exhausted_loop 直至比赛组件判定不再力竭，可能触发睡眠。"
    },
    {
      "state": "alert",
      "note": "赛前展示状态，停止移动并随机挑选最佳属性(速度/方向/反应/耐力)进入对应 alert_xxx 动画。"
    },
    {
      "state": "race_start_stunned",
      "note": "比赛起步被惊吓硬直，根据传入循环次数重复眩晕循环后恢复。"
    },
    {
      "state": "fall",
      "note": "从高处坠落状态，纵向速度模拟下落，落地(y<=0.1)后转入眩晕。"
    },
    {
      "state": "gohome",
      "note": "执行回家动作，若目标无 HasCarrat 标签则执行缓冲动作否则取消并回空闲。"

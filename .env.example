# 灰机维基账号配置
HUIJI__USERNAME=your-username
HUIJI__PASSWORD=your-password
HUIJI__X_AUTHKEY=site-authkey

# DST 根目录
DST__ROOT="/home/user/.steam/debian-installation/steamapps/common/Don't Starve Together"

# 可选：维基 API 节流与重试（默认 1 QPS、3 次退避重试）
WIKI__QPS=1
WIKI__MAX_RETRIES=3

# 可选：LLM API（未配置时 symbol-annotate --llm 会跳过 LLM 标注）
LLM__API_KEY=
LLM__BASE_URL=https://api.openai.com/v1
LLM__MODEL=gpt-4o-mini

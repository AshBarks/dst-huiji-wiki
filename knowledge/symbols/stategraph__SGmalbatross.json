  "state_notes": [
    {
      "state": "idle",
      "note": "Malbatross的基础闲置状态，停留在水面上生成涟漪和拍翅音效，用于等待或观察玩家，触发条件如动画结束或无其他行为。"
    },
    {
      "state": "eat_dive",
      "note": "Malbatross潜水捕鱼状态，尝试吃鱼时进入，成功则吃鱼，失败则返回水面；有无敌帧（noattack标签），掉落水中产生水花和波浪。"
    },
    {
      "state": "combatdive",
      "note": "Malbatross战斗潜水状态，在战斗中用于躲避或重新定位，结束后会重新出现并可能准备攻击；有短暂无敌时间（noattack标签）。"
    },
    {
      "state": "swoop_loop",
      "note": "Malbatross俯冲循环状态，快速飞行并造成范围伤害，有碰撞检测（对树木、桅杆、生物）和速度设置（15单位/秒），持续1秒后结束。"
    },
    {
      "state": "wavesplash",
      "note": "Malbatross波浪攻击状态，发动攻击时产生波浪伤害船只或玩家，攻击时机在动画29帧，有长攻击标签（longattack）并生成三道波浪。"
    },
    {
      "state": "death_ocean",
      "note": "Malbatross海洋死亡状态，在水中死亡时播放动画，掉落24根羽毛和战利品，产生大水花和波浪，有特定掉落概率和时间线。"
    },
    {
      "state": "gohome",
      "note": "Malbatross返回状态，触发时播放嘲讽动画并清除位置记忆，可能用于重置战斗或吸引玩家注意力。"
    },
    {
      "state": "taunt",
      "note": "Malbatross嘲讽状态，播放动画和音效（包括吼叫），在战斗中用于威慑玩家，触发条件如被攻击或执行回家动作。"
    },
    {
      "state": "alert",
      "note": "Malbatross警觉状态，用于准备攻击或观察玩家，有概率触发嘲讽或波浪攻击，基于计时器和战斗目标决定后续行为。"
    },
    {
      "state": "swoop_pre",
      "note": "Malbatross俯冲预备状态，锁定目标并准备俯冲，持续调整朝向，进入条件为目标有效且触发俯冲事件，为swoop_loop做准备。"
    }
  ],

  "state_notes": [
    {
      "state": "prespawn_idle",
      "note": "实体初始等待状态，启动6秒 gotospawn 计时或监听 startspawnanim 事件后进入 spawn；期间无敌且禁用音乐。"
    },
    {
      "state": "roll",
      "note": "翻滚攻击状态，以速度10向前滚动并每帧检测碰撞造成滚动伤害；翻滚次数随机，命中玩家会标记以可能提前停止。"
    },
    {
      "state": "roll_stop",
      "note": "翻滚停止状态，结束动画中触发一次范围AOE攻击，并启动 roll_cooldown 冷却计时器（时长由TUNING设定）。"
    },
    {
      "state": "tantrum",
      "note": "原地暴怒状态，循环播放动画并进行3-5次范围AOE攻击，伤害值为 TUNING.ALTERGUARDIAN_PHASE1_AOEDAMAGE。"
    },
    {
      "state": "shield",
      "note": "举盾防御状态，带 shield 标签使受击转入 shield_hit 而非硬直，调用 EnterShield 提供防御。"
    },
    {
      "state": "death",
      "note": "普通死亡状态，播放死亡动画并掉落战利品，超时后推送 phasetransition 事件以触发阶段转换。"
    },
    {
      "state": "death_lunar",
      "note": "月隙死亡状态，生成可捕获的 gestalt 分身，本体暂时失效并等待重生或捕获事件。"
    },
    {
      "state": "spawn_lunar",
      "note": "月体降临状态，播放生成动画并动态调制光照，震屏并通知范围内玩家天体守护者来袭。"
    },
    {
      "state": "captured",
      "note": "被捕获状态，实体失效并掉落战利品后侵蚀消失，对应月隙分身被成功捕获后的处理。"

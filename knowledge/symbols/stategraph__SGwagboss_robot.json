  "state_notes": [
    {
      "state": "idle",
      "note": "待机状态。Boss在此状态下可被激活，且为多数攻击的起始/结束点。播放闲置动画并设置超时自动循环。"
    },
    {
      "state": "off",
      "note": "关闭/潜伏状态。Boss初始可能在此状态，玩家靠近或触发‘activate’事件后进入‘activate’状态。无法被攻击，且占用空间。"
    },
    {
      "state": "activate",
      "note": "激活过程。播放一段较长的启动动画，期间无敌且不可打断。动画结束才进入可攻击的闲置状态。"
    },
    {
      "state": "losecontrol",
      "note": "失控阶段。Boss会切换至友好敌对模式，并在动画后恢复敌对。该状态会触发世界事件，可能开启Boss战剧情。"
    },
    {
      "state": "taunt",
      "note": "嘲讽攻击。执行一次踢击，对前方扇形区域造成AOE伤害。攻击期间短暂无敌（nointerrupt）。"
    },
    {
      "state": "tantrum_loop",
      "note": "狂暴践踏循环。Boss连续进行多次践踏攻击，每次践踏均为范围伤害，且启动时短暂无敌。攻击次数由前置状态传入。"
    },
    {
      "state": "stomp",
      "note": "跺脚攻击。近距离范围AOE伤害，并击飞、破坏附近可破坏物。攻击动画较长，但可被打断。"
    },
    {
      "state": "leap",
      "note": "跳跃攻击的空中阶段。Boss飞向目标点，期间无敌、无碰撞。撞击地面（leap_pst）时造成范围伤害。"
    },
    {
      "state": "missiles",
      "note": "导弹攻击。Boss发射3枚导弹，优先锁定附近‘热源’（如火源、玩家），并会周期性重新瞄准（TryRetargetMissiles）。"
    },
    {
      "state": "signal_loop",
      "note": "信号攻击循环。Boss持续释放信号，可能执行‘hackdrones’（招募无人机）或‘orbitalstrike’（轨道打击）等特殊技能。"
    },
    {
      "state": "death",
      "note": "死亡动画。Boss播放死亡动画，最后会召唤影怪‘alterguardian_phase4_lunarrift’作为下一阶段。掉落战利品并释放所有无人机。"
    }
  ],

      "name": "max_chase_time",
      "semantic": "最长追逐时间（秒），值变大允许追更久，值变小更快放弃"
    },
    {
      "name": "give_up_dist",
      "semantic": "放弃距离（世界单位），值变大允许目标更远才放弃，值变小更近距离就放弃"
    },
    {
      "name": "max_attacks",
      "semantic": "最大攻击次数，值变大需要更多次攻击才成功，值变小更少次就成功"
    },
    {
      "name": "findnewtargetfn",
      "semantic": "寻找新目标的函数，传入则函数返回目标时锁定，为 nil 则不自动寻找新目标"
    },
    {
      "name": "walk",
      "semantic": "是否步行（非奔跑），true 则移动慢，false 则移动快"
    },
    {
      "name": "distance_from_ocean_target",
      "semantic": "当目标不在陆地时与目标保持的海洋距离，值变大离目标更远，值变小更近"
    }
  ],

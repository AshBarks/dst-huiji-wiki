  "state_notes": [
    {
      "state": "death",
      "note": "进入条件：海象生命值归零时触发。表现：播放死亡动画，掉落战利品并移除碰撞体。数值配置：无特殊无敌帧或硬直。"
    },
    {
      "state": "taunt_newtarget",
      "note": "进入条件：获得新战斗目标且未处于攻击或忙碌状态。表现：播放挑衅动画和音效，用于仇恨吸引。数值配置：无直接伤害，可中断敌人行动。"
    },
    {
      "state": "taunt_attack",
      "note": "进入条件：doattack事件触发且海象标记为嘲讽攻击类型。表现：重置攻击计时器并播放挑衅动画，为后续攻击做准备。数值配置：无伤害输出窗口。"
    },
    {
      "state": "funny_idle",
      "note": "进入条件：闲idle状态随机进入。表现：根据海象类型和战斗状态播放不同动画（如快乐、生气、害怕）。数值配置：无伤害或硬直，纯视觉反馈。"
    },
    {
      "state": "attack",
      "note": "进入条件：doattack事件且目标在近战范围内。表现：播放攻击动画，在20帧后执行伤害判定。数值配置：近战伤害，范围由TUNING.WALRUS_MELEE_RANGE定义，有短暂攻击窗口。"
    },
    {
      "state": "blowdart",
      "note": "进入条件：doattack事件且目标不在近战范围内。表现：播放吹箭动画，17帧播放音效，20帧执行攻击。数值配置：远程伤害，有弹道延迟和射程。"
    },
    {
      "state": "eat",
      "note": "进入条件：执行EAT动作时触发。表现：播放吃动画，在10帧执行动作并移除忙碌标签。数值配置：无伤害，可恢复生命或饥饿值。"
    },
    {
      "state": "hit",
      "note": "进入条件：被攻击事件且海象未死亡。表现：播放受伤动画，更新击退延迟以防连续硬直。数值配置：有短暂无敌帧，受TUNING.WALRUS_MAX_STUN_LOCKS影响。"
    }
  ],

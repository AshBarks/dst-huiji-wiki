  "state_notes": [
    {
      "state": "idle",
      "note": "渔夫蟹空闲状态，可能触发随机动作如鞠躬或舞蹈，与玩家友好度相关。进入条件为无忙碌标签，玩家可观察其待机动画。"
    },
    {
      "state": "eat",
      "note": "吃东西状态，恢复饥饿值，分快速进食（quickeat）和普通进食。动画和音效根据食物类型调整，进食期间无敌帧较短。"
    },
    {
      "state": "fishing",
      "note": "钓鱼核心状态，渔夫蟹持竿等待鱼上钩，后续可能进入咬钩（fishing_nibble）或拉扯（fishing_strain）阶段。成功捕获或丢失钓竿影响产出。"
    },
    {
      "state": "talkto",
      "note": "对话状态，执行缓冲动作并播放对话动画，推进友好度任务或触发聊天。玩家接近时渔夫蟹可能投掷物品。"
    },
    {
      "state": "brewing_teashop",
      "note": "茶摊泡茶状态，渔夫蟹制作茶产品并抛向玩家，触发交易事件。动画包含预备和完成阶段，影响茶摊原型制作。"
    },
    {
      "state": "soakin",
      "note": "温泉浸泡状态，渔夫蟹在温泉中休息，获得持续增益。玩家需保持距离，离开会触发跳跃退出动画。"
    },
    {
      "state": "bow",
      "note": "鞠躬状态，当检测到玩家穿戴皇室装备时触发，播放鞠躬动画并可能伴随对话。动画循环直到目标离开范围。"
    },
    {
      "state": "heavylifting_start",
      "note": "开始搬运重物状态，装备重型物品后触发，播放拾取动画，影响移动速度和后续状态。"
    },
    {
      "state": "harvest",
      "note": "收获状态，处理可收获目标（如肉类），播放建造动画，完成后可能触发友好度聊天。"
    }
  ],

  "state_notes": [
    {
      "state": "charge_loop",
      "note": "普通冲锋状态，以高速直线移动并每3帧检测前方范围碰撞（EYEOFTERROR_CHARGE_AOERANGE），对树木等物体造成撞击；退出时清除速度覆盖并停止。"
    },
    {
      "state": "mouthcharge_loop",
      "note": "变形后多次冲锋循环，根据mem.mouthcharge_count进行连续冲锋，使用_chargedata.mouthchargespeed配置，超时后计数减一并返回charge_pst。"
    },
    {
      "state": "chomp",
      "note": "啃咬攻击，第25帧进行范围AOE伤害（TUNING.EYEOFTERROR_AOERANGE）并生成地洞或船漏，伴随震屏；第50帧恢复飞行状态。"
    },
    {
      "state": "spawnminieyes",
      "note": "生成地面小眼，动画中落地并孵出eyeofterror_mini_grounded加入指挥官系统，有生成冷却计时器。"
    },
    {
      "state": "spawnminieyes_mouth_loop",
      "note": "变形后从嘴吐出投射物小眼，循环生成直到达到数量上限，小眼作为弹射物发射并加入指挥官。"
    },
    {
      "state": "transform",
      "note": "变形状态，显示嘴部隐藏眼部，第33帧触发史诗惊吓，结束后标记mem.transformed改变后续冲锋与生成逻辑。"
    },
    {
      "state": "arrive",
      "note": "入场状态，前122帧处于无敌且不可攻击，播放到达语音，之后自动进入咆哮。"
    },
    {
      "state": "flyaway",
      "note": "离场状态，第23帧起获得无敌并标记为飞行，播放飞离语音，结束后推送finished_leaving事件。"
    },
    {
      "state": "death",
      "note": "死亡状态，移除碰撞体，播放死亡动画并掉落战利品，第5秒腐蚀消失进入尸体状态。"
    },
    {

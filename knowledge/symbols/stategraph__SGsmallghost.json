  "state_notes": [
    {
      "state": "idle",
      "note": "小幽灵的默认空闲状态，根据是否在执行任务播放不同动画（如 idle 或 idle_sad），玩家可通过任务系统影响其状态。"
    },
    {
      "state": "appear",
      "note": "小幽灵出现时的状态，有说话和嚎叫效果，持续短暂时间后根据任务状态转为空闲或悲伤空闲。"
    },
    {
      "state": "dissipate",
      "note": "小幽灵消散状态，通常由死亡事件触发，播放消散动画后移除实体，是不可中断的。"
    },
    {
      "state": "pickup",
      "note": "小幽灵拾取玩具时的状态，播放快乐动画并执行拾取动作，伴随音效，是任务进展的一部分。"
    },
    {
      "state": "quest_begin",
      "note": "任务开始时的状态，小幽灵播放快乐动画表示任务启动，不可攻击或中断。"
    },
    {
      "state": "quest_abandoned",
      "note": "任务放弃时的状态，小幽灵播放悲伤动画，任务中断后转回空闲。"
    },
    {
      "state": "quest_finished",
      "note": "任务完成时的状态，小幽灵播放完成动画后移除，伴随嚎叫音效，触发 detachchild 事件。"
    },
    {
      "state": "hint",
      "note": "小幽灵提示玩家时的状态，可能重复播放快乐动画并让玩家说话，直到提示结束，常用于指引互动。"
    },
    {
      "state": "play",
      "note": "小幽灵与玩家玩耍时的状态，面向目标播放快乐动画，响应 ghostplaywithme 事件，是互动玩法的一部分。"
    }

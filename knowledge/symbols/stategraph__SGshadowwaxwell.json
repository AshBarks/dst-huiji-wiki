  "state_notes": [
    {
      "state": "spawn",
      "note": "影子生成的初始状态，播放生成动画并产生水花效果，期间处于无敌（temp_invincible）和不可攻击状态。"
    },
    {
      "state": "attack",
      "note": "普通近战攻击状态。在动画第8帧移除“即将攻击”标签并造成伤害，攻击后根据是否为目标者（protector）决定是否进入待机准备姿势。攻击动画结束后有短暂硬直（第12帧移除busy标签）。"
    },
    {
      "state": "disappear",
      "note": "受击或主动消失状态。被攻击时（非死亡或无敌）会触发此状态，产生消失特效，传送到攻击者附近随机可行走位置，期间无敌且可相位穿透。"
    },
    {
      "state": "appear",
      "note": "从消失状态重新出现的动画，结束后无敌和相位状态解除，恢复正常碰撞。"
    },
    {
      "state": "lunge_loop",
      "note": "“影袭”技能的核心突进状态。影子高速突向目标，期间无敌，接触目标时造成一次强化伤害（伤害倍率由TUNING.SHADOWWAXWELL_SHADOWSTRIKE_DAMAGE_MULT定义）并触发特效。攻击或动画完成后进入收招。"
    },
    {
      "state": "death",
      "note": "死亡状态，播放死亡动画并产生消失特效后移除实体。"
    },
    {
      "state": "chop",
      "note": "持续伐木状态，可自动重复对同一目标进行砍伐。动画第2帧执行砍伐动作，第14帧尝试重复操作。"
    },
    {
      "state": "mine",
      "note": "持续挖矿状态。动画第7帧产生挖矿特效并执行动作，如果目标具有后坐力（recoil），会进入mine_recoil状态被弹开。"
    },
    {
      "state": "mine_recoil",
      "note": "挖矿击中带反冲目标后的硬直状态，影子被向后弹飞，有物理速度模拟，期间不可行动。"
    },
    {
      "state": "hit",
      "note": "普通受击硬直状态，播放受击动画，第3帧解除“忙碌”标签，可快速恢复行动。"
    }
  ],

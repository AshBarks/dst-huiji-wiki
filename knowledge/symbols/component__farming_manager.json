  "category": "component",
  "display_name": "farming_manager",
  "summary": "farming_manager组件管理土壤的湿度与养分数据，用于支持植物生长和农业系统。它周期性更新土壤湿度，并处理施肥、浇水等操作。组件还控制杂草的季节性生成和果蝇事件的触发时机。",
  "api": [
    {
      "name": "GetTileNutrients",
      "effect": "获取指定世界坐标(x,y)处的土壤养分值，返回三个数值分别代表不同养分类型。如果坐标无数据，则从地形信息中返回默认值。"
    },
    {
      "name": "SetTileNutrients",
      "effect": "设置指定世界坐标(x,y)处的土壤养分值为n1、n2、n3，并更新营养覆盖层的视觉显示。"
    },
    {
      "name": "AddTileNutrients",
      "effect": "向指定世界坐标(x,y)的土壤添加养分，每个养分值增加对应增量，结果限制在0到100之间。"
    },
    {
      "name": "CycleNutrientsAtPoint",
      "effect": "在指定点(x,y,z)执行养分循环：消耗指定类型的养分，并恢复指定类型的养分，可选测试模式仅检查是否耗尽。"
    },
    {
      "name": "GetTileBelowSoil",
      "effect": "获取指定世界坐标(x,y)处土壤下方的原始地形类型。"
    },
    {
      "name": "AddSoilMoistureAtPoint",
      "effect": "在指定点(x,y,z)改变土壤湿度，增加或减少湿度值，仅影响已注册的农业土壤。"
    },
    {
      "name": "IsSoilMoistAtPoint",
      "effect": "检查指定点(x,y,z)的土壤是否湿润，返回布尔值；如果土壤数据不存在，则根据世界湿度状态判断。"
    }
  ],

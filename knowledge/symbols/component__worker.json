  "summary": "Worker组件用于管理实体执行特定游戏动作（如采集、战斗）时的有效性或熟练度。它维护一个映射表，记录每个动作对应的数值（effectiveness），并提供了查询和设置这些数值的基本接口。该组件常被用于表示工具、角色技能或环境因素对特定行为的加成效果。",
  "api": [
    {
      "name": "GetEffectiveness",
      "signature": "Worker:GetEffectiveness(action)",
      "effect": "返回该动作在`self.actions`表中对应的数值。若该动作未被设置过，则返回0。"
    },
    {
      "name": "SetAction",
      "signature": "Worker:SetAction(action, effectiveness)",
      "effect": "将`self.actions[action]`设置为传入的`effectiveness`值。若未提供`effectiveness`参数或其值为`nil`，则默认设置为1。"
    },
    {
      "name": "CanDoAction",
      "signature": "Worker:CanDoAction(action)",
      "effect": "检查`self.actions`表中是否存在与`action`对应的条目。若存在（即有效性不为`nil`）则返回`true`，否则返回`false`。"
    }
  ],

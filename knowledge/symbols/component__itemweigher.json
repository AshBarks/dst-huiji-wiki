  "display_name": "itemweigher",
  "summary": "ItemWeigher组件管理实体的类型标签和称重回调函数。通过设置类型属性，实体会添加或移除以'trophyscale_'为前缀的标签，用于区分不同种类的秤。当执行称重操作时，组件会触发用户自定义的回调逻辑，传入实体、目标和执行者参数。组件在从实体移除时会清理类型属性。",
  "api": [
    {
      "name": "SetOnDoWeighInFn(fn)",
      "effect": "设置称重时的回调函数，该函数在DoWeighIn方法被调用时执行，传入实体、目标和执行者。"
    },
    {
      "name": "DoWeighIn(target, doer)",
      "effect": "执行称重操作，调用设置的回调函数，传入实体、目标和执行者，返回回调的返回值或nil。"
    },
    {
      "name": "OnRemoveFromEntity()",
      "effect": "组件从实体移除时调用，将type属性设置为nil，从而移除相关标签。"
    }
  ],

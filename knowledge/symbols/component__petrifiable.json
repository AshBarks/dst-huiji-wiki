  "category": "component",
  "display_name": "petrifiable",
  "summary": "该组件管理实体的石化状态和相关定时任务，用于实现石化效果。核心玩法涉及实体在特定条件下石化，并能连锁触发附近实体的石化效果。石化过程可通过回调函数定制行为，并支持保存和加载状态。",
  "api": [
    {
      "name": "OnRemoveFromEntity",
      "effect": "清理组件的石化任务和事件回调，如果实体未石化则注销世界事件并移除标签。"
    },
    {
      "name": "IsPetrified",
      "effect": "返回布尔值，表示实体当前是否处于石化状态。"
    },
    {
      "name": "SetPetrifiedFn",
      "effect": "设置石化时触发的回调函数，用于自定义石化行为。"
    },
    {
      "name": "Petrify",
      "effect": "开始石化过程：immediate 为 true 时立即石化并触发连锁；为 false 且实体睡眠时延迟唤醒后石化；否则延迟随机时间石化。石化后设置 petrified 标志并清理旧任务。"
    },
    {
      "name": "OnSave",
      "effect": "返回石化状态和剩余唤醒时间用于游戏保存，未石化则返回 nil。"
    },
    {
      "name": "OnLoad",
      "effect": "加载石化状态并恢复任务：根据保存的剩余时间设置唤醒任务或触发连锁石化。"
    },
    {
      "name": "GetDebugString",
      "effect": "返回调试信息字符串，包含石化状态、剩余唤醒时间和剩余石化时间。"
    }
  ],

  "state_notes": [
    {
      "state": "idle",
      "note": "尘螨的默认待机状态。若玩家给予蓝图物品（_giveblueprint标记），会立即被打断并进入“sneeze”状态以掉落蓝图。"
    },
    {
      "state": "sneeze",
      "note": "打喷嚏动画，带有“busy”标签。如果由给予蓝图触发，会在动画播放到第36帧时执行TryToDropBlueprint掉落蓝图。"
    },
    {
      "state": "dustoff_pre",
      "note": "清理灰尘的前置状态。进入时有20%（SNEEZE_CHANCE）概率先转为“sneeze”。若成功，会为目标移除“dustable”标签并启动重置计时器，然后进入清理循环。"
    },
    {
      "state": "dustoff_loop",
      "note": "清理灰尘的循环动画状态。循环次数为4-7次随机（4 + math.random(3)），期间播放清理音效。循环结束后进入“dustoff_pst”。"
    },
    {
      "state": "repair_den_pre",
      "note": "修复巢穴的前置状态。播放“clean_pre”动画，若目标有效则进入修复循环，否则结束。"
    },
    {
      "state": "repair_den_loop",
      "note": "核心的修复巢穴循环状态。仅在尘螨已充能（inst._charged）时执行。会播放清理动画，持续7-14次（随机5-9次循环，每次循环为两次播放），并调用目标的_start_repairing_fn。若移动超过一定距离（2.25单位平方）或目标被移除，则中断修复。"
    },
    {
      "state": "pickup",
      "note": "拾取物品状态。播放“pickup”动画，并在第16帧执行缓冲动作（如拾取食物）。"
    },
    {
      "state": "eat",
      "note": "进食状态。播放“eat”动画，并在动画结束时执行缓冲动作（消耗食物）。"
    },
    {
      "state": "search",
      "note": "搜索状态，由“dustmothsearch”事件触发。播放“idle2”动画并发出咕哝声，结束后返回“idle”。"
    }
  ],

  "category": "component",
  "display_name": "shadowlevel",
  "summary": "该组件管理实体的暗影等级数据，支持静态默认等级与动态计算函数。它在实体上添加 'shadowlevel' 标签，供其他系统查询当前暗影等级以参与暗影相关玩法逻辑。",
  "api": [
    {
      "name": "SetDefaultLevel",
      "effect": "接收参数 level 并赋值给组件实例的 self.level 字段，作为默认暗影等级；无返回值，直接修改内部状态。"
    },
    {
      "name": "SetLevelFn",
      "effect": "接收函数 fn 并赋值给组件实例的 self.levelfn 字段，用于动态计算等级；无返回值，直接修改内部状态。"
    },
    {
      "name": "GetCurrentLevel",
      "effect": "返回当前暗影等级：若 self.levelfn 已设置则调用其并传入实体返回结果，否则返回 self.level；无副作用，仅读取状态。"
    },
    {
      "name": "OnRemoveFromEntity",
      "effect": "当组件从实体移除时调用，移除实体上的 'shadowlevel' 标签；无返回值，修改实体标签状态。"
    }
  ],

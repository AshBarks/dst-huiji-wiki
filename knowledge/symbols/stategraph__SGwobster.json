  "state_notes": [
    {
      "state": "bitehook_pre",
      "note": "玩家钩住龙虾时进入，龙虾停止移动并播放挣扎动画，等待钩子连接，标记为“忙碌”状态。"
    },
    {
      "state": "bitehook_loop",
      "note": "龙虾被钩住后的循环挣扎状态，有2-2.5秒随机超时，若未及时拉起则可能挣脱，反之回到空闲。"
    },
    {
      "state": "bitehook_escape",
      "note": "龙虾逃脱钩子的状态，播放跳跃动画并产生水花效果，若在水下则隐藏动画层，之后清除钩子连接。"
    },
    {
      "state": "launched_out_of_water",
      "note": "龙虾被抛出水面时的状态，播放跳跃循环动画，可能由玩家行动触发。"
    },
    {
      "state": "spawn_in",
      "note": "龙虾生成时的状态，播放生成动画和洞穴音效，初始状态，之后进入空闲。"
    },
    {
      "state": "idle",
      "note": "龙虾空闲状态，待机行为，可转换到其他状态如移动或交互。"
    },
    {
      "state": "enter_home",
      "note": "龙虾进入家（洞）的状态，通过“回家”动作触发，标记为“忙碌”，播放短暂动画。"
    }

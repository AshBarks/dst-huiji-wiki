  "state_notes": [
    {
      "state": "idle",
      "note": "克劳斯的空闲状态，在未进行其他动作时播放待机动画。会检查是否有待执行的转换或大笑事件，并尝试触发啃咬攻击。"
    },
    {
      "state": "hit",
      "note": "克劳斯被攻击时的硬直状态，播放受击动画并播放音效。硬直结束后，根据情况转换到攻击、大笑或其他状态。"
    },
    {
      "state": "attack",
      "note": "克劳斯的普通攻击状态，播放双爪攻击动画。攻击分为两段伤害，在动画帧16和27时触发攻击判定，攻击期间具有无敌帧（nosleep/nofreeze）。"
    },
    {
      "state": "attack_chomp",
      "note": "克劳斯的啃咬攻击状态，具有突进效果。计算与目标的距离，在动画中跃向目标并造成伤害，攻击后根据目标距离决定是否接续快速攻击。有冷却时间（chomp_cd）。"
    },
    {
      "state": "command_pre",
      "note": "克劳斯指挥鹿的准备状态，停止移动并播放指挥预备动画。会挑选可施法的鹿并触发其施法事件，随后进入指挥循环状态。"
    },
    {
      "state": "command_loop",
      "note": "克劳斯指挥鹿的循环状态，持续播放指挥动画。会检查鹿的施法状态，指挥结束后进入指挥结束状态，并触发指挥冷却（command_cd）。"
    },
    {
      "state": "laugh_pre",
      "note": "克劳斯大笑的预备状态，播放大笑预备动画。此状态可被中断，用于减少大笑剩余次数（laughsremaining），影响后续行为。"
    },
    {
      "state": "transition",
      "note": "克劳斯的形态转换开始状态，根据事件执行暴怒（enrage）或召唤帮助（callforhelp）。播放转换预备动画，转换期间具有无敌帧，并触发召唤鹿的逻辑。"
    },
    {
      "state": "transition_enrage",
      "note": "克劳斯暴怒转换的完成状态，播放暴怒动画并激活暴怒状态（inst.enraged=true）。暴怒后攻击力提升，并触发摄像头震动效果。"
    },
    {
      "state": "death",

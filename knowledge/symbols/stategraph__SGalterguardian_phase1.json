  "state_notes": [
    {
      "state": "prespawn_idle",
      "note": "生成前空闲状态，实体无敌且启动6秒gotospawn计时器，等待startspawnanim事件后进入生成；期间禁用音乐与攻击。"
    },
    {
      "state": "roll",
      "note": "滚动攻击状态，实体开启滚动碰撞并持续向前冲撞，通过OnUpdateRollAttack对范围内目标造成伤害；可基于随机次数多次转向追踪目标。"
    },
    {
      "state": "tantrum",
      "note": "暴怒范围攻击状态，播放顿足动画并对周围实施3-5次AOE伤害（数值取自ALTERGUARDIAN_PHASE1_AOEDAMAGE），伴随屏幕震动与落地特效。"
    },
    {
      "state": "shield",
      "note": "护盾防御状态，调用EnterShield使实体获得shield标签，被攻击时触发shield_hit而非普通硬直，实现攻击免疫反馈。"
    },
    {
      "state": "death_lunar",
      "note": "月化裂隙死亡状态，生成可捕获的gestalt幻影并临时无敌，随后进入死亡循环等待重生或被玩家捕获。"
    },
    {
      "state": "spawn_lunar",
      "note": "月光生成状态，实体无敌并动态调整光照强度，向范围内玩家发送即将到来的提示语音（ANNOUNCE_LUNARGUARDIAN_INCOMING）。"
    },
    {
      "state": "captured",
      "note": "被捕获状态，实体失去碰撞与点击并直接掉落战利品，随后侵蚀消失（ErodeAway），用于月化重生失败或被收容。"
    }

  "display_name": "joustsource",
  "summary": "该组件管理速度、长矛长度、跑步动画循环次数和碰撞检测标签等数据。它参与饥荒联机版中的冲撞攻击核心玩法，通过 CheckCollision 方法检测与敌对实体的碰撞，造成伤害和击退效果，并可能触发冲撞事件。",
  "api": [
    {
      "name": "SetSpeed",
      "effect": "设置组件的速度值。"
    },
    {
      "name": "GetSpeed",
      "effect": "返回组件当前的速度值。"
    },
    {
      "name": "SetRunAnimLoopCount",
      "effect": "设置跑步动画的循环次数。"
    },
    {
      "name": "GetRunAnimLoopCount",
      "effect": "返回跑步动画的循环次数。"
    },
    {
      "name": "SetLanceLength",
      "effect": "设置长矛的长度值。"
    },
    {
      "name": "GetLanceLength",
      "effect": "返回长矛的长度值。"
    },
    {
      "name": "SetOnHitOtherFn",
      "effect": "设置击中其他实体时执行的回调函数。"
    },
    {
      "name": "CheckCollision",
      "effect": "检查指定实体与周围实体的碰撞。如果实体有'jousting'标签且满足角度条件，推送'joust_collide'事件；否则对非盟友敌对实体进行攻击并推送'knockback'事件。返回是否发生碰撞。"
    }
  ],

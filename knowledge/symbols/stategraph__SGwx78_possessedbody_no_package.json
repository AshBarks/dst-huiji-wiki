  "state_notes": [
    {
      "state": "spawn",
      "note": "暗影随从生成时的初始状态。拥有“无敌”和“无法攻击”标签，播放生成动画，动画完成后进入idle状态。"
    },
    {
      "state": "attack",
      "note": "核心攻击状态。根据装备的不同（如拳头、鞭子、口袋表、书、斧头等）会播放不同动画并设置不同的攻击冷却时间（如鞭子17帧，书19帧）。对目标造成伤害。"
    },
    {
      "state": "death",
      "note": "死亡状态。播放死亡动画后，实体将被移除（Remove）从游戏世界中。"
    },
    {
      "state": "take",
      "note": "执行“拾取”或“检查陷阱”等交互的状态。停止移动，播放拾取动画，并在特定帧（第6帧）执行缓冲动作。"
    },
    {
      "state": "give",
      "note": "执行“给予”或“丢弃”物品的状态。停止移动，播放给予动画，并在第14帧执行缓冲动作。"
    },
    {
      "state": "hit",
      "note": "受击硬直状态。播放受击动画，停止移动，第3帧后移除“忙碌”标签，允许后续状态转换。"
    },
    {
      "state": "mine_recoil",
      "note": "采矿或攻击后的后退硬直状态。播放后退动画，实体被向后推（物理速度覆盖），第23帧后可中断，可用于连续动作。"
    },
    {
      "state": "attack_recoil",
      "note": "特定攻击后的后退硬直状态（逻辑同 mine_recoil），播放攻击后退动画，实体被向后推。"
    },
    {
      "state": "dig",
      "note": "执行挖掘动作的循环状态。播放挖掘循环动画，在第15帧执行挖掘动作并播放音效，第35帧后可尝试重复挖掘。"
    },
    {
      "state": "dance",
